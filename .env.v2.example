# Copy with `python -m policy_lab.manage setup-env` to generate private passwords.
POSTGRES_PASSWORD=replace-with-a-long-random-password
S3_ACCESS_KEY=policy-workbench
S3_SECRET_KEY=replace-with-a-long-random-password
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=replace-with-a-long-random-password

# Existing OpenAI-compatible provider, called only by Ask / Propose change.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=deepseek-chat
POLICY_EMBEDDING_MODEL=BAAI/bge-m3
POLICY_EMBEDDING_DIMENSION=1024
POLICY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
POLICY_ENABLE_RERANKER=true
MAX_UPLOAD_MB=100
MAX_DOCUMENTS=10000
MAX_DOCUMENT_PAGES=2000
MAX_EXTRACTED_CHARACTERS=10000000
PARSER_TIMEOUT_SECONDS=900
JOB_LEASE_SECONDS=1800
SECURE_COOKIES=false
