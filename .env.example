# Required only for generated answers. Retrieval evaluation runs locally.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=deepseek-chat

# Reproducible local retrieval configuration used by the published benchmark.
RAG_EMBEDDING_BACKEND=hf
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=80
RAG_RECALL_K=10
RAG_EXTRACT_TABLES=false
